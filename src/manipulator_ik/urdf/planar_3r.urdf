<?xml version="1.0"?>
<robot name="planar_3r">
  <link name="base_link"/>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793"
           effort="10.0" velocity="1.0"/>
  </joint>
  <link name="link_1"/>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="1 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793"
           effort="10.0" velocity="1.0"/>
  </joint>
  <link name="link_2"/>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="1 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793"
           effort="10.0" velocity="1.0"/>
  </joint>
  <link name="link_3"/>

  <joint name="tool0_fixed" type="fixed">
    <parent link="link_3"/>
    <child link="tool0"/>
    <origin xyz="1 0 0" rpy="0 0 0"/>
  </joint>
  <link name="tool0"/>
</robot>
