<?xml version='1.0' encoding='utf-8'?>
<robot name="2R-Planar-URDF">
  <material name="white">
    <color rgba="1 1 1 1" />
  </material>
  <material name="orange">
    <color rgba="1 0.45 0 1" />
  </material>
  <material name="blue">
    <color rgba="0.35 0.55 0.75 1" />
  </material>
  <link name="base_link">
    <visual>
      <origin xyz="0 0 -0.05" rpy="0 0 0" />
      <geometry>
        <box size="0.2 0.2 0.1" />
      </geometry>
      <material name="orange" />
    </visual>
  </link>
  <joint name="joint_1" type="revolute">
    <parent link="base_link" />
    <child link="link_1" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="10.0" velocity="1.0" />
  </joint>
  <link name="link_1">
    <visual>
      <origin xyz="0.5 0 0" rpy="0 0 0" />
      <geometry>
        <box size="1 0.05 0.05" />
      </geometry>
      <material name="white" />
    </visual>
  </link>
  <joint name="joint_2" type="revolute">
    <parent link="link_1" />
    <child link="link_2" />
    <origin xyz="1 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="10.0" velocity="1.0" />
  </joint>
  <link name="link_2">
    <visual>
      <origin xyz="0.5 0 0" rpy="0 0 0" />
      <geometry>
        <box size="1 0.05 0.05" />
      </geometry>
      <material name="white" />
    </visual>
  </link>
  <joint name="tool0_fixed" type="fixed">
    <parent link="link_2" />
    <child link="tool0" />
    <origin xyz="1 0 0" rpy="0 0 0" />
  </joint>
  <link name="tool0">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.07" />
      </geometry>
      <material name="orange" />
    </visual>
  </link>
</robot>